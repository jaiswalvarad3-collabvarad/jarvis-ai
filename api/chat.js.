
export default async function handler(req, res) {
  const allowedOrigin =
    "https://jaiswalvarad3-collabvarad.github.io";

  res.setHeader("Access-Control-Allow-Origin", allowedOrigin);
  res.setHeader("Access-Control-Allow-Methods", "POST, OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type");

  if (req.headers.origin && req.headers.origin !== allowedOrigin) {
    return res.status(403).json({ error: "Origin not allowed" });
  }

  if (req.method === "OPTIONS") {
    return res.status(204).end();
  }

  if (req.method !== "POST") {
    return res.status(405).json({ error: "Use POST" });
  }

  const apiKey = process.env.OPENAI_API_KEY;

  if (!apiKey) {
    return res.status(500).json({
      error: "AI is not configured yet. Add OPENAI_API_KEY in Vercel."
    });
  }

  try {
    const { message } = req.body || {};

    if (typeof message !== "string" || !message.trim()) {
      return res.status(400).json({ error: "Enter a message." });
    }

    if (message.length > 4000) {
      return res.status(400).json({ error: "Message is too long." });
    }

    const response = await fetch("https://api.openai.com/v1/responses", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${apiKey}`
      },
      body: JSON.stringify({
        model: "gpt-4.1-mini",
        instructions:
          "You are JARVIS, a helpful, friendly AI assistant. Give clear, concise answers.",
        input: message.trim(),
        max_output_tokens: 500
      })
    });

    const data = await response.json();

    if (!response.ok) {
      console.error("AI API error:", response.status);
      return res.status(502).json({
        error: "The AI service could not complete your request."
      });
    }

    const answer = (data.output || [])
      .flatMap(item => item.content || [])
      .filter(item => item.type === "output_text")
      .map(item => item.text)
      .join("\n");

    if (!answer) {
      return res.status(502).json({
        error: "The AI returned no text. Please try again."
      });
    }

    return res.status(200).json({ reply: answer });
  } catch (error) {
    console.error("JARVIS backend error:", error.message);
    return res.status(500).json({
      error: "Something went wrong. Please try again."
    });
  }
}
